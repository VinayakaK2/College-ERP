generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  phone         String?   @unique
  passwordHash  String    @map("password_hash")
  role          String    @default("ADMIN")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  admin         Admin?
  teacher       Teacher?
  auditLogs     AuditLog[]
  announcements Announcement[]
  otps          OtpSession[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  adminId   String   @unique @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admins")
}

model Teacher {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  employeeId  String   @unique @map("employee_id")
  subjectId   String?  @map("subject_id")
  classId     String?  @map("class_id")
  sectionId   String?  @map("section_id")
  qualification String?
  joinDate    DateTime? @map("join_date")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject?   @relation(fields: [subjectId], references: [id])
  class     Class?     @relation(fields: [classId], references: [id])
  section   Section?   @relation(fields: [sectionId], references: [id])
  attendance Attendance[]
  marks     Mark[]

  @@map("teachers")
}

model Student {
  id             String   @id @default(uuid())
  studentId      String   @unique @map("student_id")
  rollNumber     String   @map("roll_number")
  name           String
  classId        String   @map("class_id")
  sectionId      String   @map("section_id")
  fatherName     String?  @map("father_name")
  motherName     String?  @map("mother_name")
  phone          String?
  email          String?
  address        String?
  admissionYear  Int      @map("admission_year")
  dob            DateTime?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  class      Class        @relation(fields: [classId], references: [id])
  section    Section      @relation(fields: [sectionId], references: [id])
  attendance Attendance[]
  marks      Mark[]
  fees       Fee[]
  parents    Parent[]

  @@unique([rollNumber, classId, sectionId])
  @@map("students")
}

model Parent {
  id         String @id @default(uuid())
  studentId  String @map("student_id")
  name       String
  relation   String
  phone      String
  email      String?
  password   String?
  isPrimary  Boolean @default(true) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("parents")
}

model Class {
  id        String   @id @default(uuid())
  name      String   @unique
  level     Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  students  Student[]
  sections  Section[]
  teachers  Teacher[]
  subjects  ClassSubject[]
  attendance Attendance[]

  @@map("classes")
}

model Section {
  id        String   @id @default(uuid())
  name      String
  classId   String   @map("class_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  students Student[]
  teachers Teacher[]
  attendance Attendance[]

  @@unique([name, classId])
  @@map("sections")
}

model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  maxMarks  Int      @default(100) @map("max_marks")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teachers      Teacher[]
  marks         Mark[]
  classes       ClassSubject[]
  attendance    Attendance[]

  @@map("subjects")
}

model ClassSubject {
  id        String @id @default(uuid())
  classId   String @map("class_id")
  subjectId String @map("subject_id")

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model Attendance {
  id        String    @id @default(uuid())
  studentId String    @map("student_id")
  teacherId String?   @map("teacher_id")
  subjectId String?   @map("subject_id")
  classId   String    @map("class_id")
  sectionId String    @map("section_id")
  date      DateTime
  status    String
  remarks   String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [teacherId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id])
  class   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, date])
  @@index([date])
  @@index([studentId])
  @@index([classId, sectionId])
  @@map("attendance")
}

model Mark {
  id             String    @id @default(uuid())
  studentId      String    @map("student_id")
  subjectId      String    @map("subject_id")
  examType       String    @map("exam_type")
  testName       String    @map("test_name")
  marks          Float
  maxMarks       Int       @map("max_marks")
  remarks        String?
  answerSheetUrl String?   @map("answer_sheet_url")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher? @relation(fields: [createdBy], references: [id])

  @@unique([studentId, subjectId, examType, testName])
  @@index([studentId, subjectId])
  @@map("marks")
}

model Fee {
  id              String    @id @default(uuid())
  studentId       String    @map("student_id")
  totalAmount     Float     @map("total_amount")
  paidAmount      Float     @default(0) @map("paid_amount")
  remainingAmount Float     @map("remaining_amount")
  status          String    @default("PENDING")
  dueDate         DateTime? @map("due_date")
  paymentDate     DateTime? @map("payment_date")
  description     String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([studentId])
  @@map("fees")
}

model Transaction {
  id          String   @id @default(uuid())
  feeId       String   @map("fee_id")
  amount      Float
  method      String?
  referenceNo String?  @map("reference_no")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  fee Fee @relation(fields: [feeId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Announcement {
  id            String    @id @default(uuid())
  title         String
  description   String
  audience      String
  priority      String    @default("NORMAL")
  attachmentUrl String?   @map("attachment_url")
  expiryDate    DateTime? @map("expiry_date")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [createdBy], references: [id])

  @@map("announcements")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model OtpSession {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  otp         String
  purpose     String
  attempts    Int      @default(0)
  maxAttempts Int      @default(5) @map("max_attempts")
  expiresAt   DateTime @map("expires_at")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("otp_sessions")
}
